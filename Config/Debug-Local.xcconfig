#include "App.xcconfig"

// Free personal team and iOS Simulator.
// Debug keeps MealRoutine/MealRoutine.entitlements
// (Sign in with Apple, iCloud/CloudKit, Push development, App Groups).
// Release uses MealRoutine.Release.entitlements (production push, no iCloud).
// This Local configuration does not include those. Use the MealRoutine Local scheme.

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG HOUSEHOLD_LOCAL

// http:// is written with $() so the slashes are not an xcconfig comment.
MEALROUTINE_API_BASE_URL = http:/$()/localhost:8080
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =
