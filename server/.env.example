# Copy to server/.env and replace the secret.
# The app does not require a hosted database. Postgres runs on your Mac.

DATABASE_URL=postgres://mealroutine:mealroutine@localhost:5433/mealroutine
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
GOOGLE_CLIENT_ID_IOS=
APPLE_BUNDLE_ID=com.mealroutine.app
PORT=8080
NODE_ENV=development

# Optional. Defaults: access 900 seconds, refresh 30 days, 30 auth requests per minute.
# ACCESS_TTL_SECONDS=900
# REFRESH_TTL_SECONDS=2592000
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_WINDOW_MS=60000

# Optional exact browser origin. Leave empty for the iOS app. Never use *.
# CORS_ORIGIN=
